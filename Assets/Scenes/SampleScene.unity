  m_GameObject: {fileID: 1950574500}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: UnityEngine.UI::UnityEngine.UI.Text
  m_Material: {fileID: 0}
  m_Color: {r: 0.55, g: 0.1, b: 0.1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 12800000, guid: bff34a764e5bb10418ed17812c514855, type: 3}
    m_FontSize: 13
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 10
    m_MaxSize: 40
    m_Alignment: 3
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 1
    m_LineSpacing: 1.3
  m_Text: "\U0001FA78 <b>\u0E40\u0E1A\u0E32\u0E30\u0E41\u0E2A\u0E25\u0E31\u0E1A\u0E08\u0E32\u0E01
    \u0E28.\u0E21\u0E2D\u0E23\u0E34\u0E2D\u0E32\u0E23\u0E4C\u0E15\u0E35\u0E49 (Professor
    Moriarty):</b>\n<i>\"\u0E15\u0E23\u0E32\u0E1B\u0E23\u0E30\u0E17\u0E31\u0E1A\u0E43\u0E22\u0E41\u0E21\u0E07\u0E21\u0E38\u0E21\u0E1B\u0E23\u0E32\u0E01\u0E0F\u0E04\u0E39\u0E48\u0E01\u0E31\u0E1A\u0E23\u0E2D\u0E22\u0E2B\u0E21\u0E36\u0E01\u0E02\u0E2D\u0E1A\u0E01\u0E23\u0E30\u0E14\u0E32\u0E29:
    '\u0E01\u0E38\u0E0D\u0E41\u0E08\u0E0B\u0E35\u0E0B\u0E32\u0E23\u0E4C: \u0E16\u0E2D\u0E22\u0E2B\u0E25\u0E31\u0E07
    3 \u0E15\u0E33\u0E41\u0E2B\u0E19\u0E48\u0E07 (Shift: -3)'\"</i>\n<size=12><color=#6E2828>\u2022
    \u0E43\u0E0A\u0E49\u0E27\u0E34\u0E18\u0E35\u0E40\u0E25\u0E37\u0E48\u0E2D\u0E19\u0E15\u0E31\u0E27\u0E2D\u0E31\u0E01\u0E29\u0E23\u0E22\u0E49\u0E2D\u0E19\u0E01\u0E25\u0E31\u0E1A
    3 \u0E15\u0E33\u0E41\u0E2B\u0E19\u0E48\u0E07 \u0E40\u0E1E\u0E37\u0E48\u0E2D\u0E40\u0E1B\u0E34\u0E14\u0E40\u0E1C\u0E22\u0E1E\u0E34\u0E01\u0E31\u0E14\u0E01\u0E1A\u0E14\u0E32\u0E19\u0E25\u0E31\u0E1A!</color></size>"
